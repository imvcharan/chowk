# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://chowk:chowk@localhost:5432/chowk?schema=public

# JWT/Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=7d

# Media/Streaming
MEDIA_INGEST_URL=rtmp://127.0.0.1:1935
MEDIA_HLS_URL=http://127.0.0.1:8888
PUBLIC_MEDIA_URL=http://127.0.0.1:3000/uploads
UPLOAD_DIR=./uploads

# API Configuration
API_PREFIX=api/v1
CORS_ORIGIN=*

# For Production (Render)
# DATABASE_URL=postgresql://user:password@host:5432/db_name
# JWT_ACCESS_SECRET=<use-strong-random-secret>
# NODE_ENV=production
# PUBLIC_MEDIA_URL=https://your-render-url.onrender.com/uploads